---
import '../styles/global.css';

const REPO = 'https://github.com/kelsierbot/GrimoireTUI';

const nav = [
  { group: 'grimoire', items: [
    { id: 'what',    label: 'what it is',   title: 'what it is' },
    { id: 'why',     label: 'why',          title: 'why' },
    { id: 'ondisk',  label: 'on disk',      title: 'on disk' },
  ]},
  { group: 'writing', items: [
    { id: 'desk',    label: 'the desk',     title: 'the desk' },
    { id: 'compile', label: 'compile',      title: 'compile' },
    { id: 'sync',    label: 'sync',         title: 'sync' },
  ]},
  { group: 'around it', items: [
    { id: 'themes',  label: 'themes',       title: 'themes' },
    { id: 'music',   label: 'music',        title: 'music' },
  ]},
  { group: 'get it', items: [
    { id: 'install', label: 'install',      title: 'install' },
    { id: 'status',  label: 'status',       title: 'status' },
  ]},
];
const flat = nav.flatMap((g) => g.items);
const VERSION = 'v0.5';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>grimoire — a terminal writing desk for novels</title>
    <meta
      name="description"
      content="A terminal writing desk for novels. Your manuscript is a folder of plain Markdown — it compiles to a standard-format manuscript, a paperback and an EPUB, and stays safe in any sync service. Rust and Ratatui."
    />
    <link rel="canonical" href="https://grimoire.joshking.ai/" />
    <meta name="theme-color" content="#0d0d10" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://grimoire.joshking.ai/" />
    <meta property="og:title" content="grimoire — a terminal writing desk for novels" />
    <meta
      property="og:description"
      content="Your manuscript is a folder of plain Markdown. No database, no lock-in, diffable in git."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>

  <body>
    <div class="screen">
      <header class="titlebar">
        <span class="brand">grimoire</span>
        <span class="desc">a terminal writing desk for novels</span>
        <span class="right"><a href={REPO}>github</a></span>
      </header>

      <main class="panes">
        <nav class="pane tree" id="tree" data-focused="false" aria-label="Contents">
          <span class="label">contents</span>
          <div class="pane-body">
          {nav.map((g) => (
            <>
              <div class="group">{g.group}</div>
              <ol role="tablist" aria-orientation="vertical">
                {g.items.map((it, i) => (
                  <li>
                    <button
                      role="tab"
                      id={`tab-${it.id}`}
                      data-id={it.id}
                      aria-controls={it.id}
                      aria-selected={it.id === 'what' ? 'true' : 'false'}
                      tabindex={it.id === 'what' ? 0 : -1}
                    >{it.label}</button>
                  </li>
                ))}
              </ol>
            </>
          ))}
          </div>
        </nav>

        <div class="pane doc" id="doc" data-focused="true">
          <span class="label" id="doc-label">what it is</span>
          <div class="pane-body" id="doc-body">

          <section id="what" role="tabpanel" aria-labelledby="tab-what">
            <h2>what it is</h2>
            <p>
              Grimoire is a writing desk for novels that lives in your terminal. It knows what a
              manuscript is — parts, chapters, scenes, word targets — and it keeps all of it as
              plain files you could read with <code>cat</code>.
            </p>
            <figure class="shot">
              <img src="/shots/desk.webp" width="1620" height="1114" loading="eager"
                alt="Grimoire in the Lost Forest theme: a book's outline under a spellbook, a scene being written, the Pomodoro forest and the music pane" />
              <figcaption>01 — the desk: the outline, the prose, the Pomodoro, the music</figcaption>
            </figure>
            <p>
              When the book is done it compiles a submission manuscript in standard format, a
              print-ready paperback and an EPUB — and while you write it keeps the
              book safe in whatever syncs it: Dropbox, Google Drive, pCloud, Box.
            </p>
            <p class="mute">Rust and Ratatui. One binary. macOS, Linux and Windows.</p>
          </section>

          <section id="why" role="tabpanel" aria-labelledby="tab-why">
            <h2>why</h2>
            <p>
              Every open-source novel tool makes one of two mistakes. It traps your manuscript in a
              database, or it is a text editor with no idea what a manuscript is.
            </p>
            <p>
              Grimoire does neither. <strong>The directory tree is the outline.</strong> There is no
              index file, so there is no central thing to conflict when you sync across machines.
              Reordering is renaming. Backing up is copying a folder.
            </p>
            <p>
              If this project is abandoned tomorrow you still have your book. That is the whole
              design constraint, and everything else follows from it — including that nothing is
              ever deleted: autosave, recovery, per-scene history, and a trash you can undo from.
            </p>
            <p class="mute">
              Frontmatter is round-tripped verbatim — Grimoire reads a few keys and never rewrites
              the block, so Obsidian can own fields it has never heard of.
            </p>
          </section>

          <section id="ondisk" role="tabpanel" aria-labelledby="tab-ondisk">
            <h2>on disk</h2>
            <p>Folders are containers, at any depth. Files are scenes. Order comes from the name.</p>
            <div class="grid-block">
              <pre><b>the-salt-archive/</b>
├─ novel.toml                    <i>title, targets, your details</i>
├─ manuscript/
│  └─ 01-Part-One/
│     ├─ 01-Chapter-One/
│     │  ├─ <b>01-Scene-One.md</b>          <i>a scene</i>
│     │  └─ <b>02-Scene-Two.md</b>
│     └─ 02-Chapter-Two/ …
├─ characters/<b>wren.md</b>            <i>the notebook</i>
├─ places/  notes/  research/
├─ front-matter/  back-matter/    <i>by edition</i>
└─ .grimoire/                    <i>history, recovery, trash</i></pre>
            </div>
            <p>A leading <code>01-</code> orders the file and is stripped for display.</p>
            <div class="grid-block">
              <pre>---
<b>title</b>: Scene One
<b>pov</b>: Wren
<b>status</b>: draft
<b>synopsis</b>: Wren comes back to the archive at night.
<b>target</b>: 1500
---</pre>
            </div>
          </section>

          <section id="desk" role="tabpanel" aria-labelledby="tab-desk">
            <h2>the desk</h2>
            <table class="keys">
              <tbody>
                <tr><td>Esc</td><td>the menu — everything is in it, down to Quit</td></tr>
                <tr><td>Ctrl-K</td><td>find anything: actions, scenes, notes, themes</td></tr>
                <tr><td>Tab</td><td>switch pane</td></tr>
                <tr><td>n · c · p</td><td>new scene · chapter · part, named and placed for you</td></tr>
                <tr><td>r · d</td><td>rename · delete (to the trash, and undoable)</td></tr>
                <tr><td>Ctrl-D</td><td>focus mode — just the prose, centred</td></tr>
                <tr><td>Ctrl-T</td><td>every %% note %% and TK in the book</td></tr>
                <tr><td>v</td><td>another scene beside this one, read-only</td></tr>
                <tr><td>F8</td><td>spelling — or click the underlined word</td></tr>
                <tr><td>Ctrl-Z · Ctrl-Y</td><td>undo · redo, in the prose and in the tree</td></tr>
                <tr><td>F2 · F9</td><td>the timer · themes</td></tr>
              </tbody>
            </table>
            <figure class="shot">
              <img src="/shots/focus.webp" width="1620" height="1114" loading="lazy"
                alt="Focus mode in the Kanagawa theme: only the prose, centred" />
              <figcaption>02 — focus mode</figcaption>
            </figure>
            <p>
              Notes between <code>%%</code> marks and <code>TK</code> placeholders never reach the
              book or the word count. Vertical movement is <strong>visual, not logical</strong>:
              Down moves one screen row inside a wrapped paragraph, which is the only behaviour
              that feels right for prose.
            </p>
          </section>

          <section id="compile" role="tabpanel" aria-labelledby="tab-compile">
            <h2>compile</h2>
            <p>
              Export compiles a submission manuscript in
              <strong>William Shunn's standard manuscript format</strong>.
            </p>
            <figure class="shot">
              <img src="/shots/manuscript.webp" width="3005" height="1330" loading="lazy"
                alt="The first three pages of a compiled manuscript: a title page with contact block and word count, Part One and Chapter One on the opening page, a page with a centred # scene break" />
              <figcaption>03 — a manuscript for agents and editors</figcaption>
            </figure>
            <ul>
              <li>your contact block, byline and a rounded word count on the title page</li>
              <li>Surname / KEYWORD / page on every page after it</li>
              <li>chapters a third of the way down, a centred # between scenes, END</li>
              <li>curly quotes and real dashes — your files are left as you typed them</li>
              <li>samples an agent asks for: chapters 1–3, or the first N words</li>
              <li>Times or Courier, Letter or A4, and a PDF through LibreOffice</li>
            </ul>
            <figure class="shot">
              <img src="/shots/paperback.webp" width="1700" height="1310" loading="lazy"
                alt="A spread from a 6x9 paperback: a left page with the author's running head facing a chapter opener with a small-caps lead-in" />
              <figcaption>04 — a print-ready paperback, 5×8 to 6×9</figcaption>
            </figure>
            <p>
              The same book compiles as a <strong>paperback</strong> — mirrored margins with the
              gutter KDP asks for, running heads, chapters on the right-hand page, justified and
              hyphenated — and as an <strong>EPUB</strong> with a cover, contents and metadata.
            </p>
            <p class="mute">
              Empty scenes and chapters are left out, and every TK is listed before anything is
              written.
            </p>
          </section>

          <section id="sync" role="tabpanel" aria-labelledby="tab-sync">
            <h2>sync</h2>
            <p>
              A book is a folder, so any sync service carries it. Grimoire makes sure none of them
              can lose your words.
            </p>
            <figure class="shot">
              <img src="/shots/conflicts.webp" width="1620" height="1114" loading="lazy"
                alt="Settling a Dropbox conflict copy: the scene on the left, the copy on the right, and the choice to take the copy, keep the scene or keep both" />
              <figcaption>05 — two devices wrote one scene; nothing was lost</figcaption>
            </figure>
            <ul>
              <li><strong>Nothing is written over.</strong> Every save checks the file first; a change from elsewhere is kept beside the scene.</li>
              <li>Conflict copies from Dropbox, pCloud, Google Drive, Box, OneDrive, iCloud and Syncthing are recognised, never counted or exported twice, and settled side by side.</li>
              <li>A file that isn't downloaded yet shows as offline and is never saved over.</li>
              <li>Names are safe on every service and system, and writing history lives outside the synced folder.</li>
            </ul>
            <p class="mute">Checked against each service's documented behaviour, and on a real pCloud Drive.</p>
          </section>

          <section id="themes" role="tabpanel" aria-labelledby="tab-themes">
            <h2>themes</h2>
            <p>
              Nineteen themes, and each brings its own world to the pane under the outline. The
              <strong>Pomodoro</strong> is the timer — the sun's position is the clock, and break
              time is night.
            </p>
            <figure class="shot">
              <img src="/shots/pomodoros.webp" width="1632" height="1198" loading="lazy"
                alt="Nineteen small Pomodoro scenes, one per theme: a tower, snowy peaks, a castle, cats, the great wave, a neon grid and more" />
              <figcaption>06 — every theme's Pomodoro, mid-session</figcaption>
            </figure>
            <p>
              <code>→</code> turns it into the <strong>Visualizer</strong>: a spectrum of whatever the
              computer is playing, drawn in the theme's own style, with the song's name on it.
            </p>
            <figure class="shot">
              <img src="/shots/visualizers.webp" width="1632" height="1198" loading="lazy"
                alt="Nineteen music visualizers, one per theme: meters, beads, frost, a neon skyline, a rolling wave, a synthwave grid" />
              <figcaption>07 — every theme's Visualizer</figcaption>
            </figure>
            <p class="mute">A custom theme mixes and matches: any theme's world with any theme's Visualizer.</p>
          </section>

          <section id="music" role="tabpanel" aria-labelledby="tab-music">
            <h2>music</h2>
            <p>Music is off until you turn it on. Four sources:</p>
            <table class="keys">
              <tbody>
                <tr><td>YouTube Music</td><td>drives th-ch's desktop app through its API server — queue, search, your playlists</td></tr>
                <tr><td>Spotify</td><td>drives the desktop app (macOS and Linux)</td></tr>
                <tr><td>Jellyfin</td><td><strong>Grimoire plays it</strong> — your files, your server</td></tr>
                <tr><td>Plex</td><td><strong>Grimoire plays it</strong> — your files, your server</td></tr>
              </tbody>
            </table>
            <div class="grid-block">
              <pre><b>┌ ♪ YouTube Music · F7 ──────┐</b>
<b>│</b><i>▶ Low Tide</i>                  <b>│</b>
<b>│</b><i>━━━━━━━━</i>─────────── 2:11 <i>↻</i> <b>│</b>
<b>└ [ prev · space ⏯ · ] next ─┘</b></pre>
            </div>
            <p class="mute">
              Grimoire never extracts streams from YouTube Music or Spotify: it presses the buttons of
              the app you already pay for.
            </p>
          </section>

          <section id="install" role="tabpanel" aria-labelledby="tab-install">
            <h2>install</h2>
            <p>macOS and Linux:</p>
            <p>
              <code class="cmd">curl --proto '=https' --tlsv1.2 -LsSf https://github.com/kelsierbot/GrimoireTUI/releases/latest/download/grimoire-tui-installer.sh | sh</code>
            </p>
            <p>Windows (PowerShell):</p>
            <p>
              <code class="cmd">powershell -ExecutionPolicy Bypass -c "irm https://github.com/kelsierbot/GrimoireTUI/releases/latest/download/grimoire-tui-installer.ps1 | iex"</code>
            </p>
            <p>Or with Homebrew:</p>
            <p>
              <code class="cmd">brew tap kelsierbot/tap</code>
              <code class="cmd">brew trust kelsierbot/tap</code>
              <code class="cmd">brew install grimoire</code>
            </p>
            <p>
              Then open a new terminal and run <strong>grimoire</strong>. No Rust, no build tools.
              From source: <code>cargo install --path .</code> in a clone of
              <a href={REPO}>the repo</a>.
            </p>
            <p class="mute">
              Linux needs glibc 2.35+ and ALSA's audio library, which every desktop distro already has.
              PDFs need LibreOffice.
            </p>
          </section>

          <section id="status" role="tabpanel" aria-labelledby="tab-status">
            <h2>status</h2>
            <p>
              v0.5 — written in daily. Outlining, writing, notes, history, sync safety, and compiling
              for agents, print and e-readers are all here.
            </p>
            <p>Not yet:</p>
            <ul>
              <li>the phone app — <span class="mute">running on Android, not released</span></li>
              <li>spellcheck in languages other than English</li>
              <li>Spotify on Windows</li>
            </ul>
            <p class="mute">MIT. Issues and patches welcome at <a href={REPO}>the repo</a>.</p>
          </section>
          </div>
        </div>
      </main>

      <footer class="statusbar">
        <span class="pos" id="pos">1/{flat.length}</span>
        <span class="keys-hint">
          <span class="hint"><kbd>j</kbd>/<kbd>k</kbd> move</span>
          <span class="hint"><kbd>Tab</kbd> pane</span>
          <span class="hint"><kbd>g</kbd> github</span>
        </span>
        <span class="right">{VERSION} · MIT · Rust + Ratatui</span>
      </footer>
    </div>

    <script is:inline define:vars={{ REPO }}>
      const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
      const panels = Array.from(document.querySelectorAll('[role="tabpanel"]'));
      const label = document.getElementById('doc-label');
      const pos = document.getElementById('pos');
      const tree = document.getElementById('tree');
      const doc = document.getElementById('doc');
      const docBody = document.getElementById('doc-body');
      let i = 0;

      function show(next, moveFocus) {
        i = (next + tabs.length) % tabs.length;
        const id = tabs[i].dataset.id;
        tabs.forEach((t, n) => {
          t.setAttribute('aria-selected', String(n === i));
          t.tabIndex = n === i ? 0 : -1;
        });
        panels.forEach((p) => {
          const on = p.id === id;
          p.classList.toggle('on', on);
          p.hidden = !on;
        });
        label.textContent = tabs[i].textContent;
        pos.textContent = `${i + 1}/${tabs.length}`;
        history.replaceState(null, '', `#${id}`);
        if (docBody) docBody.scrollTop = 0;
        if (moveFocus) tabs[i].focus();
      }

      tabs.forEach((t, n) => t.addEventListener('click', () => { setPane('tree'); show(n, true); }));

      let pane = 'doc';
      function setPane(p) {
        pane = p;
        tree.dataset.focused = String(p === 'tree');
        doc.dataset.focused = String(p === 'doc');
      }
      setPane('doc');

      addEventListener('keydown', (e) => {
        const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName) || e.target.isContentEditable;
        if (typing || e.metaKey || e.ctrlKey || e.altKey) return;

        if (e.key === 'Tab') { e.preventDefault(); setPane(pane === 'tree' ? 'doc' : 'tree'); return; }
        if (e.key === 'g') { location.href = REPO; return; }

        const down = e.key === 'j' || e.key === 'ArrowDown';
        const up = e.key === 'k' || e.key === 'ArrowUp';
        if (down || up) {
          if (pane === 'doc' && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) return; // let it scroll
          e.preventDefault();
          setPane('tree');
          show(i + (down ? 1 : -1), true);
        }
      });

      const start = tabs.findIndex((t) => `#${t.dataset.id}` === location.hash);
      show(start > -1 ? start : 0, false);
    </script>
  </body>
</html>
