---
import '../styles/global.css';
import THEMES from '../themes.json';

const REPO = 'https://github.com/kelsierbot/GrimoireTUI';

const nav = [
  { group: 'grimoire', items: [
    { id: 'what',    label: 'what it is',   title: 'what it is' },
    { id: 'why',     label: 'why',          title: 'why' },
    { id: 'ondisk',  label: 'on disk',      title: 'on disk' },
  ]},
  { group: 'writing', items: [
    { id: 'desk',    label: 'the desk',     title: 'the desk' },
    { id: 'compile', label: 'compile',      title: 'compile' },
    { id: 'sync',    label: 'sync',         title: 'sync' },
  ]},
  { group: 'around it', items: [
    { id: 'themes',  label: 'themes',       title: 'themes' },
    { id: 'music',   label: 'music',        title: 'music' },
  ]},
  { group: 'get it', items: [
    { id: 'install', label: 'install',      title: 'install' },
    { id: 'donate',  label: 'donate',       title: 'donate' },
    { id: 'status',  label: 'status',       title: 'status' },
  ]},
];
const flat = nav.flatMap((g) => g.items);
const VERSION = 'v0.5';
const STUDIO = 'https://catfinity.com';
const KOFI = 'https://ko-fi.com/F2F21E0DK0';
const DEFAULT_THEME = 'Rainbow';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>grimoire — a terminal writing desk for novels</title>
    <meta
      name="description"
      content="A terminal writing desk for novels. Your manuscript is a folder of plain Markdown — it compiles to a standard-format manuscript, a paperback and an EPUB, and stays safe in any sync service. Rust and Ratatui."
    />
    <link rel="canonical" href="https://grimoire.joshking.ai/" />
    <meta name="theme-color" content="#15121f" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://grimoire.joshking.ai/" />
    <meta property="og:title" content="grimoire — a terminal writing desk for novels" />
    <meta
      property="og:description"
      content="Your manuscript is a folder of plain Markdown. No database, no lock-in, diffable in git."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ THEMES, DEFAULT_THEME }}>
      // Before the first paint: the viewer's chosen theme, so the page never
      // flashes Rainbow on its way to Nord.
      document.documentElement.classList.add('js');
      window.GRIMOIRE_THEMES = THEMES;
      try {
        const want = localStorage.getItem('grimoire-theme');
        const t = THEMES.find((x) => x.name === want);
        if (t && t.name !== DEFAULT_THEME) {
          const s = document.documentElement.style;
          s.setProperty('--bg', t.bg); s.setProperty('--line', t.border); s.setProperty('--sel', t.sel);
          s.setProperty('--text', t.text); s.setProperty('--mute', t.dim); s.setProperty('--focus', t.accent);
          s.setProperty('--spectrum', `linear-gradient(${t.accent}, ${t.accent})`); s.setProperty('--hl', t.accent);
        }
      } catch (e) {}
    </script>
  </head>

  <body>
    <div class="screen">
      <header class="titlebar">
        <span class="brand">grimoire</span>
        <span class="desc">a terminal writing desk for novels</span>
        <span class="right">
          <button class="theme-btn" id="theme-btn" type="button" aria-haspopup="dialog" title="Change the theme (t)">
            <span class="swatch" aria-hidden="true"></span> theme · <span class="rb" id="theme-name">{DEFAULT_THEME}</span>
          </button>
          <a href={REPO}>github</a>
        </span>
      </header>

      <main class="panes">
        <div class="left">
        <nav class="pane tree" id="tree" data-focused="false" aria-label="Contents">
          <span class="label"><span class="t">contents</span></span>
          <div class="pane-body">
          <canvas class="book" id="book" aria-hidden="true"></canvas>
          {nav.map((g) => (
            <>
              <div class="group">{g.group}</div>
              <ol role="tablist" aria-orientation="vertical">
                {g.items.map((it, i) => (
                  <li>
                    <button
                      role="tab"
                      id={`tab-${it.id}`}
                      data-id={it.id}
                      aria-controls={it.id}
                      aria-selected={it.id === 'what' ? 'true' : 'false'}
                      tabindex={it.id === 'what' ? 0 : -1}
                    >{it.label}</button>
                  </li>
                ))}
              </ol>
            </>
          ))}
          </div>
        </nav>

        <aside class="pane clearing" data-focused="false" aria-hidden="true">
          <span class="label"><span class="t" id="pomo-tag">writing</span> · <span class="time" id="pomo-time">12:39</span></span>
          <div class="pane-body">
            <canvas id="pomodoro"></canvas>
            <img id="pomo-img" alt="" width="224" height="158" hidden />
          </div>
        </aside>
        </div>

        <div class="pane doc" id="doc" data-focused="true">
          <span class="label"><span class="t" id="doc-label">what it is</span></span>
          <div class="pane-body" id="doc-body">

          <section id="what" role="tabpanel" aria-labelledby="tab-what">
            <h2>what it is</h2>
            <p>
              Grimoire is a cozy little writing desk for your novel, and it lives right in your
              terminal. It understands how a book comes together, from parts and chapters down to
              scenes and word goals, and it keeps every word you write in plain files you can open
              with anything, even <code>cat</code>.
            </p>
            <figure class="shot">
              <img id="hero" src="/shots/themes/rainbow.webp" width="1620" height="1114" loading="eager"
                alt="Grimoire in the Rainbow theme: a book's outline under a spellbook, a scene being written, the Pomodoro and the music pane" />
              <figcaption>01 — the desk, in <span id="hero-theme">Rainbow</span>: the outline, the prose, the Pomodoro, the music</figcaption>
            </figure>
            <p class="try">
              <strong>Nineteen themes</strong>, and you can change them any time — <kbd>F9</kbd> in
              the app. Try them on this page: press <kbd>t</kbd>, or
              <button class="link-btn" type="button" data-open-picker>pick a theme</button>.
            </p>
            <p>
              When the book is done it compiles a submission manuscript in standard format, a
              print-ready paperback and an EPUB — and while you write it keeps the
              book safe in whatever syncs it: Dropbox, Google Drive, pCloud, Box.
            </p>
            <p class="mute">
              Rust and Ratatui. One binary. macOS, Linux and Windows. Made by
              <a href={STUDIO}>Catfinity Studios</a>.
            </p>
          </section>

          <section id="why" role="tabpanel" aria-labelledby="tab-why">
            <h2>why</h2>
            <p>
              Every open-source novel tool makes one of two mistakes. It traps your manuscript in a
              database, or it is a text editor with no idea what a manuscript is.
            </p>
            <p>
              Grimoire does neither. <strong>The directory tree is the outline.</strong> There is no
              index file, so there is no central thing to conflict when you sync across machines.
              Reordering is renaming. Backing up is copying a folder.
            </p>
            <p>
              If this project is abandoned tomorrow you still have your book. That is the whole
              design constraint, and everything else follows from it — including that nothing is
              ever deleted: autosave, recovery, per-scene history, and a trash you can undo from.
            </p>
            <p class="mute">
              Frontmatter is round-tripped verbatim — Grimoire reads a few keys and never rewrites
              the block, so Obsidian can own fields it has never heard of.
            </p>
          </section>

          <section id="ondisk" role="tabpanel" aria-labelledby="tab-ondisk">
            <h2>on disk</h2>
            <p>Folders are containers, at any depth. Files are scenes. Order comes from the name.</p>
            <div class="grid-block">
              <pre><b>the-salt-archive/</b>
├─ novel.toml                    <i>title, targets, your details</i>
├─ manuscript/
│  └─ 01-Part-One/
│     ├─ 01-Chapter-One/
│     │  ├─ <b>01-Scene-One.md</b>          <i>a scene</i>
│     │  └─ <b>02-Scene-Two.md</b>
│     └─ 02-Chapter-Two/ …
├─ characters/<b>wren.md</b>            <i>the notebook</i>
├─ places/  notes/  research/
├─ front-matter/  back-matter/    <i>by edition</i>
└─ .grimoire/                    <i>history, recovery, trash</i></pre>
            </div>
            <p>A leading <code>01-</code> orders the file and is stripped for display.</p>
            <div class="grid-block">
              <pre>---
<b>title</b>: Scene One
<b>pov</b>: Wren
<b>status</b>: draft
<b>synopsis</b>: Wren comes back to the archive at night.
<b>target</b>: 1500
---</pre>
            </div>
          </section>

          <section id="desk" role="tabpanel" aria-labelledby="tab-desk">
            <h2>the desk</h2>
            <table class="keys">
              <tbody>
                <tr><td>Esc</td><td>the menu — everything is in it, down to Quit</td></tr>
                <tr><td>F1 · ?</td><td>the help — every feature explained, opened where you are</td></tr>
                <tr><td>Ctrl-K</td><td>find anything: actions, scenes, notes, themes</td></tr>
                <tr><td>Tab</td><td>switch pane</td></tr>
                <tr><td>n · c · p</td><td>new scene · chapter · part, named and placed for you</td></tr>
                <tr><td>r · d</td><td>rename · delete (to the trash, and undoable)</td></tr>
                <tr><td>Ctrl-D</td><td>focus mode — just the prose, centred</td></tr>
                <tr><td>Ctrl-T</td><td>every %% note %% and TK in the book</td></tr>
                <tr><td>v</td><td>another scene beside this one, read-only</td></tr>
                <tr><td>F8</td><td>spelling — or click the underlined word</td></tr>
                <tr><td>Ctrl-Z · Ctrl-Y</td><td>undo · redo, in the prose and in the tree</td></tr>
                <tr><td>F9</td><td>themes — nineteen, each with its own world, or make your own</td></tr>
                <tr><td>F2</td><td>the Pomodoro timer</td></tr>
              </tbody>
            </table>
            <figure class="shot">
              <img src="/shots/focus.webp" width="1620" height="1114" loading="lazy"
                alt="Focus mode in the Kanagawa theme: only the prose, centred" />
              <figcaption>02 — focus mode</figcaption>
            </figure>
            <p>
              Every feature is explained inside, too: <code>F1</code> opens the help on the topic
              for wherever you are, and typing searches all of it.
            </p>
            <figure class="shot">
              <img src="/shots/help.webp" width="1620" height="1114" loading="lazy"
                alt="The help inside Grimoire: the topics on the left, Writing open on the right" />
              <figcaption>03 — the help, opened from the page</figcaption>
            </figure>
            <p>
              Notes between <code>%%</code> marks and <code>TK</code> placeholders never reach the
              book or the word count. Vertical movement is <strong>visual, not logical</strong>:
              Down moves one screen row inside a wrapped paragraph, which is the only behaviour
              that feels right for prose.
            </p>
          </section>

          <section id="compile" role="tabpanel" aria-labelledby="tab-compile">
            <h2>compile</h2>
            <p>
              Export compiles a submission manuscript in
              <strong>William Shunn's standard manuscript format</strong>.
            </p>
            <figure class="shot">
              <img src="/shots/manuscript.webp" width="3005" height="1330" loading="lazy"
                alt="The first three pages of a compiled manuscript: a title page with contact block and word count, Part One and Chapter One on the opening page, a page with a centred # scene break" />
              <figcaption>04 — a manuscript for agents and editors</figcaption>
            </figure>
            <ul>
              <li>your contact block, byline and a rounded word count on the title page</li>
              <li>Surname / KEYWORD / page on every page after it</li>
              <li>chapters a third of the way down, a centred # between scenes, END</li>
              <li>curly quotes and real dashes — your files are left as you typed them</li>
              <li>samples an agent asks for: chapters 1–3, or the first N words</li>
              <li>Times or Courier, Letter or A4, and a PDF through LibreOffice</li>
            </ul>
            <figure class="shot">
              <img src="/shots/paperback.webp" width="1700" height="1310" loading="lazy"
                alt="A spread from a 6x9 paperback: a left page with the author's running head facing a chapter opener with a small-caps lead-in" />
              <figcaption>05 — a print-ready paperback, 5×8 to 6×9</figcaption>
            </figure>
            <p>
              The same book compiles as a <strong>paperback</strong> — mirrored margins with the
              gutter KDP asks for, running heads, chapters on the right-hand page, justified and
              hyphenated — and as an <strong>EPUB</strong> with a cover, contents and metadata.
            </p>
            <p class="mute">
              Empty scenes and chapters are left out, and every TK is listed before anything is
              written.
            </p>
          </section>

          <section id="sync" role="tabpanel" aria-labelledby="tab-sync">
            <h2>sync</h2>
            <p>
              A book is a folder, so any sync service carries it. Grimoire makes sure none of them
              can lose your words.
            </p>
            <figure class="shot">
              <img src="/shots/conflicts.webp" width="1620" height="1114" loading="lazy"
                alt="Settling a Dropbox conflict copy: the scene on the left, the copy on the right, and the choice to take the copy, keep the scene or keep both" />
              <figcaption>06 — two devices wrote one scene; nothing was lost</figcaption>
            </figure>
            <ul>
              <li><strong>Nothing is written over.</strong> Every save checks the file first; a change from elsewhere is kept beside the scene.</li>
              <li>Conflict copies from Dropbox, pCloud, Google Drive, Box, OneDrive, iCloud and Syncthing are recognised, never counted or exported twice, and settled side by side.</li>
              <li>A file that isn't downloaded yet shows as offline and is never saved over.</li>
              <li>Names are safe on every service and system, and writing history lives outside the synced folder.</li>
            </ul>
            <p class="mute">Checked against each service's documented behaviour, and on a real pCloud Drive.</p>
          </section>

          <section id="themes" role="tabpanel" aria-labelledby="tab-themes">
            <h2>themes</h2>
            <p>
              <strong>Nineteen themes</strong>, and you can switch any time with <kbd>F9</kbd> — the
              picker previews each one as you move through it. This page switches too; try one:
            </p>
            <div class="chips" role="group" aria-label="Themes">
              {THEMES.map((t) => (
                <button type="button" data-theme={t.name} aria-pressed={t.name === DEFAULT_THEME ? 'true' : 'false'}>
                  <i style={t.name === 'Rainbow' ? undefined : `background:${t.accent}`} class={t.name === 'Rainbow' ? 'spec' : undefined}></i>
                  <span class="n">{t.name}</span>
                </button>
              ))}
            </div>
            <p>
              Each theme brings its own world to the pane under the outline. The
              <strong>Pomodoro</strong> is the timer — the sun's position is the clock, and break
              time is night.
            </p>
            <figure class="shot">
              <img src="/shots/pomodoros.webp" width="1632" height="1198" loading="lazy"
                alt="Nineteen small Pomodoro scenes, one per theme: a tower, snowy peaks, a castle, cats, the great wave, a neon grid and more" />
              <figcaption>07 — every theme's Pomodoro, mid-session</figcaption>
            </figure>
            <p>
              <code>→</code> turns it into the <strong>Visualizer</strong>: a spectrum of whatever the
              computer is playing, drawn in the theme's own style, with the song's name on it.
            </p>
            <figure class="shot">
              <img src="/shots/visualizers.webp" width="1632" height="1198" loading="lazy"
                alt="Nineteen music visualizers, one per theme: meters, beads, frost, a neon skyline, a rolling wave, a synthwave grid" />
              <figcaption>08 — every theme's Visualizer</figcaption>
            </figure>
            <p class="mute">
              Rainbow's colours flow round the wheel every twelve seconds. A custom theme mixes and
              matches: any theme's world with any theme's Visualizer.
            </p>
          </section>

          <section id="music" role="tabpanel" aria-labelledby="tab-music">
            <h2>music</h2>
            <p>Music is off until you turn it on. Four sources:</p>
            <table class="keys">
              <tbody>
                <tr><td>YouTube Music</td><td>drives th-ch's desktop app through its API server — queue, search, your playlists</td></tr>
                <tr><td>Spotify</td><td>drives the desktop app (macOS and Linux)</td></tr>
                <tr><td>Jellyfin</td><td><strong>Grimoire plays it</strong> — your files, your server</td></tr>
                <tr><td>Plex</td><td><strong>Grimoire plays it</strong> — your files, your server</td></tr>
              </tbody>
            </table>
            <div class="grid-block">
              <pre><b>┌ ♪ YouTube Music · F7 ──────┐</b>
<b>│</b><i>▶ Low Tide</i>                  <b>│</b>
<b>│</b><i>━━━━━━━━</i>─────────── 2:11 <i>↻</i> <b>│</b>
<b>└ [ prev · space ⏯ · ] next ─┘</b></pre>
            </div>
            <p class="mute">
              Grimoire never extracts streams from YouTube Music or Spotify: it presses the buttons of
              the app you already pay for.
            </p>
          </section>

          <section id="install" role="tabpanel" aria-labelledby="tab-install">
            <h2>install</h2>
            <p>macOS and Linux:</p>
            <p>
              <code class="cmd">curl --proto '=https' --tlsv1.2 -LsSf https://github.com/kelsierbot/GrimoireTUI/releases/latest/download/grimoire-tui-installer.sh | sh</code>
            </p>
            <p>Windows (PowerShell):</p>
            <p>
              <code class="cmd">powershell -ExecutionPolicy Bypass -c "irm https://github.com/kelsierbot/GrimoireTUI/releases/latest/download/grimoire-tui-installer.ps1 | iex"</code>
            </p>
            <p>Or with Homebrew:</p>
            <p>
              <code class="cmd">brew tap kelsierbot/tap</code>
              <code class="cmd">brew trust kelsierbot/tap</code>
              <code class="cmd">brew install grimoire</code>
            </p>
            <p>
              Then open a new terminal and run <strong>grimoire</strong>. No Rust, no build tools.
              From source: <code>cargo install --path .</code> in a clone of
              <a href={REPO}>the repo</a>.
            </p>
            <p class="mute">
              Linux needs glibc 2.35+ and ALSA's audio library, which every desktop distro already has.
              PDFs need LibreOffice.
            </p>
          </section>

          <section id="donate" role="tabpanel" aria-labelledby="tab-donate">
            <h2>donate</h2>
            <p>
              Grimoire is free, and a donation is <strong>never required</strong> — but it is
              appreciated, and it goes toward Grimoire's development.
            </p>
            <p class="kofi">
              <a href={KOFI} target="_blank" rel="noopener noreferrer"><img
                height="36" style="border:0px;height:36px;" src="https://storage.ko-fi.com/cdn/kofi6.png?v=6"
                alt="Buy Me a Coffee at ko-fi.com" /></a>
            </p>
            <p class="mute">
              In the app it's <em>Donate…</em> in the menu. Thank you for writing with it.
            </p>
          </section>

          <section id="status" role="tabpanel" aria-labelledby="tab-status">
            <h2>status</h2>
            <p>
              v0.5 — written in daily. Outlining, writing, notes, history, sync safety, and compiling
              for agents, print and e-readers are all here.
            </p>
            <p>Not yet:</p>
            <ul>
              <li>the phone app — <span class="mute">running on Android, not released</span></li>
              <li>spellcheck in languages other than English</li>
              <li>Spotify on Windows</li>
            </ul>
            <p class="mute">MIT. Issues and patches welcome at <a href={REPO}>the repo</a>.</p>
          </section>
          </div>
        </div>
      </main>

      <dialog class="pane picker" id="picker" aria-label="Themes" data-focused="true">
        <span class="label"><span class="t">themes</span></span>
        <ol class="pick-list" id="pick-list">
          {THEMES.map((t) => (
            <li>
              <button type="button" data-theme={t.name}>
                <span class="mark" aria-hidden="true"></span>
                <span class="n">{t.name}</span>
                {t.name === 'Rainbow'
                  ? <span class="sw spec-bar" aria-hidden="true"></span>
                  : <span class="sw" aria-hidden="true">{[t.accent, t.sun, t.moon, t.foliage, t.bloom].map((c) => <i style={`background:${c}`}></i>)}</span>}
              </button>
            </li>
          ))}
        </ol>
        <p class="pick-hint"><kbd>↑↓</kbd> preview · <kbd>↵</kbd> choose · <kbd>esc</kbd> cancel</p>
      </dialog>

      <footer class="statusbar">
        <span class="pos" id="pos">1/{flat.length}</span>
        <span class="keys-hint">
          <span class="hint"><kbd>j</kbd>/<kbd>k</kbd> move</span>
          <span class="hint"><kbd>Tab</kbd> pane</span>
          <span class="hint"><kbd>t</kbd> theme</span>
          <span class="hint"><kbd>g</kbd> github</span>
        </span>
        <span class="right">{VERSION} · MIT · <a href={STUDIO}>Catfinity Studios</a></span>
      </footer>
    </div>

    <script is:inline define:vars={{ REPO }}>
      const tabs = Array.from(document.querySelectorAll('[role="tab"]'));
      const panels = Array.from(document.querySelectorAll('[role="tabpanel"]'));
      const label = document.getElementById('doc-label');
      const pos = document.getElementById('pos');
      const tree = document.getElementById('tree');
      const doc = document.getElementById('doc');
      const docBody = document.getElementById('doc-body');
      let i = 0;

      function show(next, moveFocus) {
        i = (next + tabs.length) % tabs.length;
        const id = tabs[i].dataset.id;
        tabs.forEach((t, n) => {
          t.setAttribute('aria-selected', String(n === i));
          t.tabIndex = n === i ? 0 : -1;
        });
        panels.forEach((p) => {
          const on = p.id === id;
          p.classList.toggle('on', on);
          p.hidden = !on;
        });
        label.textContent = tabs[i].textContent;
        pos.textContent = `${i + 1}/${tabs.length}`;
        history.replaceState(null, '', `#${id}`);
        if (docBody) docBody.scrollTop = 0;
        if (moveFocus) tabs[i].focus();
      }

      tabs.forEach((t, n) => t.addEventListener('click', () => { setPane('tree'); show(n, true); }));

      let pane = 'doc';
      function setPane(p) {
        pane = p;
        tree.dataset.focused = String(p === 'tree');
        doc.dataset.focused = String(p === 'doc');
      }
      setPane('doc');

      addEventListener('keydown', (e) => {
        if (document.getElementById('picker').open) return;
        const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName) || e.target.isContentEditable;
        if (typing || e.metaKey || e.ctrlKey || e.altKey) return;

        if (e.key === 'Tab') { e.preventDefault(); setPane(pane === 'tree' ? 'doc' : 'tree'); return; }
        if (e.key === 'g') { location.href = REPO; return; }

        const down = e.key === 'j' || e.key === 'ArrowDown';
        const up = e.key === 'k' || e.key === 'ArrowUp';
        if (down || up) {
          if (pane === 'doc' && (e.key === 'ArrowDown' || e.key === 'ArrowUp')) return; // let it scroll
          e.preventDefault();
          setPane('tree');
          show(i + (down ? 1 : -1), true);
        }
      });

      const start = tabs.findIndex((t) => `#${t.dataset.id}` === location.hash);
      show(start > -1 ? start : 0, false);
    </script>
    <script is:inline define:vars={{ DEFAULT_THEME }}>
      // The themes, as the app draws them. Rainbow's spectrum turns on one
      // clock (80 ms ticks, a full turn every 12 s); the spellbook heads the
      // outline in the theme's own inks; and the Pomodoro under it is the
      // theme's world — drawn live for Rainbow, a still from the app for the
      // rest. The viewer's choice is remembered in this browser only.
      (() => {
        const THEMES = window.GRIMOIRE_THEMES;
        const byName = (n) => THEMES.find((t) => t.name === n);
        const root = document.documentElement;
        const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        let T = byName(DEFAULT_THEME), rainbow = true;

        const rgb = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
        const blend = (a, b, t) => {
          const A = rgb(a), B = rgb(b);
          return '#' + A.map((v, i) => Math.round(v + (B[i] - v) * t).toString(16).padStart(2, '0')).join('');
        };

        // The spectrum the stylesheet lays over the screen, sampled at a
        // point, so the canvases' accent cells match the text around them.
        const A = (132 * Math.PI) / 180, DX = Math.sin(A), DY = -Math.cos(A);
        let drift = 0, rem = 16;
        const measure = () => { rem = parseFloat(getComputedStyle(root).fontSize) || 16; };
        const accentAt = (x, y) => {
          if (!rainbow) return T.accent;
          const w = root.clientWidth, h = root.clientHeight, period = 46 * rem;
          const t = (x - w / 2) * DX + (y - h / 2) * DY + (Math.abs(w * DX) + Math.abs(h * DY)) / 2;
          const hue = (drift + (360 * (((t % period) + period) % period)) / period) % 360;
          return `hsl(${hue.toFixed(1)}, 90%, 68%)`;
        };

        const CW = 8;
        const FONT = '13.33px "IBM Plex Mono", ui-monospace, monospace';
        function setup(cv, cols, rows, rh) {
          const d = devicePixelRatio || 1, w = cols * CW, h = rows * rh;
          cv.width = Math.round(w * d); cv.height = Math.round(h * d);
          cv.style.width = w + 'px'; cv.style.height = h + 'px';
          const ctx = cv.getContext('2d');
          ctx.setTransform(d, 0, 0, d, 0, 0);
          ctx.font = FONT; ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
          return ctx;
        }
        const shown = (cv) => cv && cv.offsetParent !== null;

        // ── the spellbook ──
        const ART = [
          '    ✧   ·    ✦    ·   ✧',
          '      ______ ☾ ______',
          '    _/      ╲│╱      \\_',
          '   // ≈≈≈ ≈≈ │ ≈≈ ≈≈≈ \\\\',
          '  // ≈ ≈≈ ✧  │  ✧ ≈≈ ≈ \\\\',
          ' //__________│__________\\\\',
          " `───────────┴───────────'",
        ];
        const BRH = 15;
        const book = document.getElementById('book');
        let bctx = null;
        function drawBook(frame) {
          if (!shown(book)) return;
          bctx = bctx || setup(book, 26, ART.length, BRH);
          const r = book.getBoundingClientRect(), ctx = bctx;
          ctx.clearRect(0, 0, 26 * CW, ART.length * BRH);
          let spark = 0;
          ART.forEach((line, row) => {
            [...line].forEach((c, col) => {
              if (c === ' ') return;
              const x = (col + 0.5) * CW, y = (row + 0.5) * BRH;
              let g = c, ink;
              if (row === 0) {
                spark += 1;
                const beat = (Math.floor(frame / (4 + (spark % 3))) + spark) % 4;
                [g, ink] = beat === 0 ? ['✦', T.sun] : beat % 2 ? ['✧', blend(T.sun, T.dim, 0.35)] : ['·', T.dim];
              } else if (c === '╲' || c === '╱') ink = blend(T.sun, T.dim, 0.5);
              else if (c === '☾') ink = T.moon;
              else if (c === '✧') ink = T.bloom;
              else if (c === '≈') ink = T.dim;
              else ink = accentAt(r.left + x, r.top + y);
              ctx.fillStyle = ink;
              // Rules are drawn, not typed, so they meet cell to cell.
              const cx = col * CW, cy = row * BRH;
              if (c === '─' || c === '┴') ctx.fillRect(cx, Math.round(y), CW, 1);
              if (c === '│' || c === '┴') ctx.fillRect(Math.round(x), cy, 1, c === '┴' ? BRH / 2 : BRH);
              if (c === '─' || c === '│' || c === '┴') return;
              ctx.fillText(g, x, y);
            });
          });
        }

        // ── Rainbow's Pomodoro: a fine arc of five ribbons, in braille dots ──
        const W = 28, H = 9, PRH = 16, ACX = 28, ACY = (H - 1) * 4, AR = 24, PITCH = 4, THICK = 2, BANDS = 5;
        const bandAt = (x, y) => {
          const d = AR - Math.hypot(x + 0.5 - ACX, y + 0.5 - ACY);
          if (d < 0) return -1;
          const k = Math.floor(d / PITCH);
          return k < BANDS && d - k * PITCH < THICK ? k : -1;
        };
        const PUFFS = [[3.5, 29, 3.2], [7.5, 27, 4.2], [11.5, 29.5, 3.0]];
        const inCloud = (x, y, at) => PUFFS.some(([px, py, r]) => Math.hypot(x - px - at, y - py) <= r);
        const driftDots = (frame, seed) => (Math.floor(frame / 20) + seed) % 3;

        const WRITE = 25 * 60, BREAK = 5 * 60;
        const t0 = performance.now() - (WRITE - (12 * 60 + 39)) * 1000;
        const pomo = document.getElementById('pomodoro');
        const pomoImg = document.getElementById('pomo-img');
        const tagEl = document.getElementById('pomo-tag'), timeEl = document.getElementById('pomo-time');
        let pctx = null;
        function drawPomodoro(now, frame) {
          const s = ((now - t0) / 1000) % (WRITE + BREAK);
          const night = s >= WRITE, len = night ? BREAK : WRITE, e = night ? s - WRITE : s;
          const progress = e / len, left = Math.max(0, Math.ceil(len - e));
          const tag = night ? 'break' : 'writing';
          const time = `${String(Math.floor(left / 60)).padStart(2, '0')}:${String(left % 60).padStart(2, '0')}`;
          if (tagEl.textContent !== tag) tagEl.textContent = tag;
          if (timeEl.textContent !== time) timeEl.textContent = time;
          if (!shown(pomo)) return;
          pctx = pctx || setup(pomo, W, H, PRH);
          const ctx = pctx, r = pomo.getBoundingClientRect();
          ctx.clearRect(0, 0, W * CW, H * PRH);
          const BAND = [T.warn, blend(T.warn, T.sun, 0.5), T.sun, T.foliage, blend(T.moon, T.bloom, 0.4)];

          // The feet stand in two clouds that drift a dot or two.
          const cloud = new Map();
          [[0, 0], [2 * W - 15, 7]].forEach(([at0, seed]) => {
            const at = at0 + (still ? 0 : driftDots(frame, seed));
            for (let y = (H - 3) * 4; y < (H - 1) * 4; y++)
              for (let x = 0; x < 2 * W; x++)
                if (inCloud(x + 0.5, y + 0.5, at)) {
                  const k = `${x >> 1},${y >> 2}`;
                  cloud.set(k, (cloud.get(k) || []).concat([[x, y]]));
                }
          });

          // By day a light runs slowly along the outer band, then rests.
          const run = (frame % 160) * 1.5;
          const dot = (x, y) => { ctx.beginPath(); ctx.arc(x * 4 + 2, y * 4 + 2, 1.15, 0, 7); ctx.fill(); };
          for (let cy = 2; cy < H - 1; cy++) {
            for (let cx = 0; cx < W; cx++) {
              if (cloud.has(`${cx},${cy}`)) continue;
              const angle = (Math.atan2(ACY - cy * 4 - 2, ACX - cx * 2 - 1) * 180) / Math.PI;
              for (let col = 0; col < 2; col++) {
                for (let row = 0; row < 4; row++) {
                  const x = cx * 2 + col, y = cy * 4 + row, k = bandAt(x, y);
                  if (k < 0) continue;
                  let c = BAND[k];
                  if (k === 0 && !night && !still && Math.abs(angle - run) < 7) c = blend(c, T.text, 0.55);
                  if (night) c = blend(c, T.border, 0.6);
                  ctx.fillStyle = c;
                  dot(x, y);
                }
              }
            }
          }
          ctx.fillStyle = blend(T.text, T.border, 0.55);
          cloud.forEach((dots) => dots.forEach(([x, y]) => dot(x, y)));

          // The clock: the sun crosses the sky; at break, the moon.
          const span = W - 4;
          const sx = 2 + Math.min(Math.round(progress * span), span - 1);
          const sy = Math.sin(Math.PI * progress) > 0.5 ? 0 : 1;
          ctx.fillStyle = night ? T.moon : T.sun;
          ctx.fillText(night ? '☾' : '☀', (sx + 0.5) * CW, (sy + 0.5) * PRH);

          // The ground fills in behind the sun, in the accent.
          const head = Math.round(progress * W);
          for (let x = 0; x < W; x++) {
            ctx.fillStyle = x < head ? accentAt(r.left + (x + 0.5) * CW, r.top + (H - 1) * PRH) : T.turf;
            ctx.fillRect(x * CW, (H - 1) * PRH, CW, 2);
          }
        }

        function draw(now) {
          drawBook(Math.floor(now / 250));
          drawPomodoro(now, Math.floor(now / 80));
        }

        // ── switching ──
        const hero = document.getElementById('hero'), heroTheme = document.getElementById('hero-theme');
        const nameEl = document.getElementById('theme-name');
        const meta = document.querySelector('meta[name="theme-color"]');
        const picker = document.getElementById('picker');
        const rows = Array.from(picker.querySelectorAll('[data-theme]'));
        const chips = Array.from(document.querySelectorAll('.chips [data-theme]'));

        function apply(t, keep) {
          T = t;
          rainbow = t.name === 'Rainbow';
          const s = root.style;
          s.setProperty('--bg', t.bg); s.setProperty('--line', t.border); s.setProperty('--sel', t.sel);
          s.setProperty('--text', t.text); s.setProperty('--mute', t.dim); s.setProperty('--focus', t.accent);
          if (rainbow) {
            s.removeProperty('--spectrum'); s.removeProperty('--hl');
          } else {
            s.setProperty('--spectrum', `linear-gradient(${t.accent}, ${t.accent})`);
            s.setProperty('--hl', t.accent);
          }
          if (meta) meta.setAttribute('content', t.bg);
          nameEl.textContent = t.name;
          heroTheme.textContent = t.name;
          const src = `/shots/themes/${t.slug}.webp`;
          if (!hero.src.endsWith(src)) hero.src = src;
          hero.alt = `Grimoire in the ${t.name} theme: a book's outline under a spellbook, a scene being written, the Pomodoro and the music pane`;
          pomo.hidden = !rainbow;
          pomoImg.hidden = rainbow;
          if (!rainbow) pomoImg.src = `/shots/themes/pomodoro-${t.slug}.webp`;
          chips.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.theme === t.name)));
          rows.forEach((b) => b.classList.toggle('current', b.dataset.theme === t.name));
          if (keep) {
            try { localStorage.setItem('grimoire-theme', t.name); } catch (e) {}
          }
          draw(performance.now());
        }

        // The picker previews as you move and puts things back on Esc, as
        // the app's does.
        let before = null, opening = false;
        function openPicker() {
          if (picker.open) return;
          // The browser focuses the first row as the dialog opens; ignore
          // that, and start on the theme in use.
          const here = rows.find((r) => r.dataset.theme === T.name) || rows[0];
          before = T;
          opening = true;
          picker.showModal();
          opening = false;
          here.focus();
        }
        rows.forEach((b) => {
          b.addEventListener('focus', () => { if (picker.open && !opening) apply(byName(b.dataset.theme), false); });
          b.addEventListener('click', () => {
            before = null;
            apply(byName(b.dataset.theme), true);
            picker.close();
          });
        });
        picker.addEventListener('keydown', (e) => {
          const n = rows.indexOf(document.activeElement);
          const step = e.key === 'ArrowDown' || e.key === 'j' ? 1 : e.key === 'ArrowUp' || e.key === 'k' ? -1 : 0;
          if (!step) return;
          e.preventDefault();
          rows[(n + step + rows.length) % rows.length].focus();
        });
        picker.addEventListener('click', (e) => {
          const r = picker.getBoundingClientRect();
          if (e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom) picker.close();
        });
        picker.addEventListener('close', () => {
          if (before) apply(before, false);
          before = null;
        });
        document.getElementById('theme-btn').addEventListener('click', openPicker);
        document.querySelectorAll('[data-open-picker]').forEach((b) => b.addEventListener('click', openPicker));
        chips.forEach((b) => b.addEventListener('click', () => apply(byName(b.dataset.theme), true)));
        addEventListener('keydown', (e) => {
          if (picker.open || e.metaKey || e.ctrlKey || e.altKey) return;
          if (/^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName) || e.target.isContentEditable) return;
          if (e.key === 't' || e.key === 'F9') {
            e.preventDefault();
            openPicker();
          }
        });

        measure();
        addEventListener('resize', () => { measure(); bctx = pctx = null; draw(performance.now()); });
        let saved = null;
        try { saved = byName(localStorage.getItem('grimoire-theme')); } catch (e) {}
        apply(saved || T, false);

        if (still) {
          setInterval(() => draw(performance.now()), 1000);
          return;
        }
        let last = -1;
        (function tick(now) {
          // Rainbow moves every 80 ms; the other themes only twinkle.
          const f = rainbow ? Math.floor(now / 80) : -Math.floor(now / 250);
          if (f !== last) {
            last = f;
            if (rainbow) {
              drift = ((now / 12000) * 360) % 360;
              root.style.setProperty('--drift', drift.toFixed(2) + 'deg');
            }
            draw(now);
          }
          requestAnimationFrame(tick);
        })(performance.now());
      })();
    </script>
  </body>
</html>
