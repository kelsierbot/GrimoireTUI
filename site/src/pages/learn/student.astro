---
import Learn from '../../layouts/Learn.astro';
import Lines from '../../components/Lines.astro';
import KeyCard from '../../components/KeyCard.astro';

const toc = [
  ['keys', 'Your key card'],
  ['day-1', 'Day 1 · Open the book'],
  ['day-2', 'Day 2 · Build the bones'],
  ['planner', 'Story planner'],
  ['cards', 'Scene cards'],
  ['day-3', 'Day 3 · Draft'],
  ['day-4', 'Day 4 · Revise'],
  ['day-5', 'Day 5 · Publish'],
  ['certificate', 'Your certificate'],
];
---

<Learn
  title="Student workbook · A Week with Grimoire"
  description="A free five-day student workbook for Grimoire, the terminal writing desk: daily handouts, a key card, a story planner, scene cards and a certificate. Ready to print."
  path="/learn/student/"
  kind="student"
>
  <main>
    <section class="hero">
      <p class="eyebrow">A Week with Grimoire · student workbook</p>
      <h1>Write a story in <span class="rb">five days</span></h1>
      <p class="lede">
        By Friday you'll have a finished short story, printed like a real manuscript. Each day has
        steps to follow, things to try, and space to think. Go at your own pace, and ask for help
        whenever you like.
      </p>
      <div class="btn-row no-print">
        <button class="btn primary" data-print="all"><span class="ico" aria-hidden="true">⎙</span> Print the whole workbook</button>
        <button class="btn" data-print="keys"><span class="ico" aria-hidden="true">⌨</span> Print the key card</button>
      </div>
    </section>

    <div class="doc-wrap">
      <aside class="toc no-print" aria-label="On this page">
        <p>In this workbook</p>
        <ol>{toc.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
        <button class="btn small" data-print="all">⎙ Print everything</button>
      </aside>

      <div class="doc">
        <!-- KEY CARD -->
        <section id="keys" class="block" data-printable>
          <h2>Your key card</h2>
          <p>Keep this next to your keyboard. <kbd>Ctrl</kbd> can be <kbd>Cmd</kbd> on some Macs.</p>
          <div class="day-tools no-print"><button class="btn small" data-print="keys">⎙ Print this card</button></div>
          <KeyCard />
          <div class="note tip">
            <span class="label">Two things to remember</span>
            <p>Lost? Press <kbd>Esc</kbd>. Everything is in the menu. Worried you'll lose your work? You won't: it saves itself a couple of seconds after you stop typing.</p>
          </div>
        </section>

        <!-- DAY 1 -->
        <section id="day-1" class="day" data-printable>
          <div class="day-head">
            <span class="day-num" aria-hidden="true">1</span>
            <span class="day-kicker">Day 1</span>
            <h2>Open the book</h2>
          </div>
          <div class="day-tools no-print"><button class="btn small" data-print="day-1">⎙ Print this day</button></div>
          <p class="intro">Today you'll make a book of your own, learn your way around, and write your first scene.</p>

          <h3>Follow along</h3>
          <ol class="steps">
            <li>Open a terminal: <em>Terminal</em> on a Mac, <em>Windows Terminal</em> on Windows, or any terminal on Linux.</li>
            <li>Make your book. Type this and press <kbd>Enter</kbd> (if you share a computer, add your name, like <code>my-story-sam</code>):
              <pre class="cmd"><code>grimoire new ~/Documents/my-story</code></pre>
              On Windows, type <code>grimoire new $HOME\Documents\my-story</code> instead.</li>
            <li>Open it with the command Grimoire shows you, like <code>grimoire ~/Documents/my-story</code>.</li>
            <li>Your book opens on a page called <em>Novel Format</em>. Read it: it explains how your book is laid out.</li>
            <li>Press <kbd>Tab</kbd> to move between the panes. Press <kbd>Esc</kbd> to open the menu, and <kbd>Esc</kbd> again to close it.</li>
            <li>In the outline, use <kbd>↑</kbd> <kbd>↓</kbd> to move and <kbd>Enter</kbd> to open <em>Part One › Chapter One › Scene One</em>.</li>
            <li>Press <kbd>Tab</kbd> to move to the page, and start writing.</li>
            <li>Stop typing for a moment and watch the bottom of the screen: <em>saved</em>. You never have to save.</li>
            <li>Press <kbd>Ctrl-Q</kbd> to quit, then open your book again. You're right where you left off.</li>
          </ol>

          <h3>Freewrite <span class="tag">10 minutes</span></h3>
          <p>In Scene One, write without stopping: <strong>someone finds a door that shouldn't be open.</strong> Who are they? What's on the other side? Don't fix anything yet.</p>

          <h3>Scavenger hunt</h3>
          <ul class="check">
            <li>Find <em>Quit Grimoire</em> at the bottom of the menu (<kbd>Esc</kbd>).</li>
            <li>Open the help with <kbd>F1</kbd> and read one topic.</li>
            <li>Press <kbd>Ctrl-K</kbd>, type <em>theme</em>, and see what it finds.</li>
            <li>Find the <em>Trash</em> at the bottom of the outline.</li>
            <li>Pick a theme you like with <kbd>F9</kbd>: <kbd>↑</kbd> <kbd>↓</kbd> to preview, <kbd>Enter</kbd> to keep.</li>
          </ul>

          <h3>Look back</h3>
          <Lines n={3} prompt="What surprised you about writing in a terminal?" />
          <Lines n={2} prompt="One idea from your freewrite you might keep:" />

          <h3>Exit ticket</h3>
          <Lines n={1} prompt="1. How do you open the menu?" />
          <Lines n={1} prompt="2. Name two parts of the desk." />
          <Lines n={1} prompt="3. When is your writing saved?" />
          <Lines n={1} prompt="4. How do you quit?" />
        </section>

        <!-- DAY 2 -->
        <section id="day-2" class="day" data-printable>
          <div class="day-head">
            <span class="day-num" aria-hidden="true">2</span>
            <span class="day-kicker">Day 2</span>
            <h2>Build the bones</h2>
          </div>
          <div class="day-tools no-print"><button class="btn small" data-print="day-2">⎙ Print this day</button></div>
          <p class="intro">Today you'll plan your story in three movements and shape your outline to match it.</p>

          <div class="note tip">
            <span class="label">Three movements</span>
            <p><strong>Beginning</strong>: who wants what, and where are they? <strong>Middle</strong>: what gets in the way, and how does it get worse? <strong>End</strong>: what changes? Fill in the story planner first.</p>
          </div>

          <h3>Shape your outline</h3>
          <ol class="steps">
            <li>Your book starts with three parts. A short story needs one. In the outline, select <em>Part Two</em>, press <kbd>d</kbd>, then <kbd>y</kbd>. It goes to the Trash. Do the same for <em>Part Three</em>.</li>
            <li>Changed your mind? <kbd>Ctrl-Z</kbd> in the outline brings back whatever you deleted.</li>
            <li>Your three movements live in <em>Chapter One</em>, <em>Chapter Two</em> and <em>Chapter Three</em>. To give one a name, select it and press <kbd>r</kbd>. Empty chapters can stay: they're left out of your finished story.</li>
            <li>Press <kbd>Ctrl-Q</kbd>. Open your book's folder and open <code>novel.toml</code> in a plain text editor. Change the <code>title</code>, and set <code>target_words</code> and <code>daily_target</code> to the numbers your teacher gives you. Save, then open Grimoire again.</li>
          </ol>

          <h3>Fill in the corkboard</h3>
          <ol class="steps">
            <li>In the outline, press <kbd>b</kbd>. Every scene is a card.</li>
            <li>On each card, press <kbd>e</kbd> and write one sentence about what happens. Press <kbd>Enter</kbd> to keep it.</li>
            <li>Press <kbd>v</kbd> to say whose eyes we're behind in that scene (the point of view).</li>
            <li>Press <kbd>s</kbd> until the status says <em>outline</em>.</li>
            <li>Plan two or three scenes per chapter. Need another? In the outline, select a chapter and press <kbd>n</kbd>.</li>
            <li><kbd>Esc</kbd> or <kbd>b</kbd> closes the board.</li>
          </ol>

          <h3>Look back</h3>
          <Lines n={3} prompt="Tell your whole story in three sentences: beginning, middle, end." />

          <h3>Exit ticket</h3>
          <Lines n={1} prompt="1. On your computer, what is a chapter? What is a scene?" />
          <Lines n={1} prompt="2. You deleted the wrong thing. What do you do?" />
          <Lines n={1} prompt="3. Name two things on a scene card." />
        </section>

        <!-- PLANNER -->
        <section id="planner" class="block page" data-printable>
          <h2>Story planner</h2>
          <div class="day-tools no-print"><button class="btn small" data-print="planner">⎙ Print the planner</button></div>
          <div class="boxes three">
            <div class="box tall"><span class="k">Beginning · Chapter One</span><p class="q">Who is your main character? What do they want? Where are we?</p></div>
            <div class="box tall"><span class="k">Middle · Chapter Two</span><p class="q">What gets in the way? How does it get worse?</p></div>
            <div class="box tall"><span class="k">End · Chapter Three</span><p class="q">What changes? What's different at the very end?</p></div>
          </div>
          <h3>Your main character</h3>
          <div class="boxes two">
            <div class="box">
              <div class="card-field"><b>Name</b><i></i></div>
              <div class="card-field"><b>Wants</b><i></i></div>
              <div class="card-field"><b>Fears</b><i></i></div>
              <div class="card-field"><b>A secret</b><i></i></div>
              <div class="card-field"><b>One detail</b><i></i></div>
            </div>
            <div class="box">
              <span class="k">Where it happens</span>
              <div class="card-field"><b>Place</b><i></i></div>
              <div class="card-field"><b>When</b><i></i></div>
              <div class="card-field"><b>A smell</b><i></i></div>
              <div class="card-field"><b>A sound</b><i></i></div>
              <div class="card-field"><b>Something odd</b><i></i></div>
            </div>
          </div>
          <Lines n={4} prompt="The title (for now):" />
        </section>

        <!-- SCENE CARDS -->
        <section id="cards" class="block page" data-printable>
          <h2>Scene cards</h2>
          <p class="no-print">Plan on paper first if you like, then type each card into the corkboard.</p>
          <div class="day-tools no-print"><button class="btn small" data-print="cards">⎙ Print the scene cards</button></div>
          <div class="boxes two">
            {[1, 2, 3, 4, 5, 6].map((n) => (
              <div class="box">
                <span class="k">Scene {n}</span>
                <div class="card-field"><b>Chapter</b><i></i></div>
                <div class="card-field"><b>POV</b><i></i></div>
                <div class="card-field"><b>What happens</b><i></i></div>
                <div class="card-field"><b></b><i></i></div>
                <div class="status-row"><span>idea</span><span>outline</span><span>draft</span><span>revised</span><span>done</span></div>
              </div>
            ))}
          </div>
        </section>

        <!-- DAY 3 -->
        <section id="day-3" class="day" data-printable>
          <div class="day-head">
            <span class="day-num" aria-hidden="true">3</span>
            <span class="day-kicker">Day 3</span>
            <h2>Draft</h2>
          </div>
          <div class="day-tools no-print"><button class="btn small" data-print="day-3">⎙ Print this day</button></div>
          <p class="intro">Today you'll write fast. A first draft is allowed to be messy. That's what it's for.</p>

          <div class="note say">
            <span class="label">The sprint rules</span>
            <p>Don't fix. Don't delete. Mark it and keep going.</p>
          </div>

          <h3>Follow along</h3>
          <ol class="steps">
            <li>Open your first scene.</li>
            <li>Press <kbd>Esc</kbd> and choose <em>Start a sprint…</em>. Type your word goal, press <kbd>Tab</kbd>, type the minutes, and press <kbd>Enter</kbd>.</li>
            <li>Press <kbd>Ctrl-D</kbd> for focus mode: just your words. <kbd>Ctrl-D</kbd> again brings everything back.</li>
            <li>Don't know a detail? Type <code>TK</code> and keep going: <em>she caught the TK train north.</em></li>
            <li>Want to remember something? Put it between two pairs of percent signs: <code>%% check the date %%</code>. Notes never reach your story and don't count as words.</li>
            <li>Watch the sun cross the sky in the Pomodoro, and the sprint count in the status bar.</li>
            <li>When you finish a scene, open the next one in the outline and keep going.</li>
            <li>At the end, press <kbd>Ctrl-T</kbd> to see every note and TK you left.</li>
          </ol>

          <h3>Sprint log</h3>
          <div class="table-wrap">
            <table class="table">
              <thead><tr><th>Sprint</th><th>Goal</th><th>Words written</th><th>How it felt</th></tr></thead>
              <tbody>
                <tr><td>1</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
                <tr><td>2</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
                <tr><td>3</td><td>&nbsp;</td><td>&nbsp;</td><td>&nbsp;</td></tr>
              </tbody>
            </table>
          </div>

          <h3>Stuck? Borrow a sentence</h3>
          <ul>
            <li>Then the phone rang.</li>
            <li>Nobody noticed that the clock had stopped.</li>
            <li>"You weren't supposed to see that," she said.</li>
            <li>The worst possible thing happened next.</li>
            <li>It was the smell that gave it away.</li>
          </ul>

          <h3>Look back</h3>
          <Lines n={3} prompt="What helped you keep going? What made you want to stop?" />

          <h3>Exit ticket</h3>
          <Lines n={1} prompt="1. What does TK mean?" />
          <Lines n={1} prompt="2. Do notes count toward your word count?" />
          <Lines n={1} prompt="3. How do you see every note and TK at once?" />
        </section>

        <!-- DAY 4 -->
        <section id="day-4" class="day" data-printable>
          <div class="day-head">
            <span class="day-num" aria-hidden="true">4</span>
            <span class="day-kicker">Day 4</span>
            <h2>Revise</h2>
          </div>
          <div class="day-tools no-print"><button class="btn small" data-print="day-4">⎙ Print this day</button></div>
          <p class="intro">Today you'll finish your draft, then make it better: clear your notes, fix spelling and names, and listen to a partner.</p>

          <h3>Follow along</h3>
          <ol class="steps">
            <li>Finish your draft. An ending with a TK or two still counts.</li>
            <li>Press <kbd>Ctrl-T</kbd> and go through every note and TK. Fill in each TK, and fix or delete each note.</li>
            <li>Spelling: click an underlined word for suggestions, or press <kbd>F8</kbd>. For a made-up name, choose <em>Always ignore: this book</em>.</li>
            <li>Your main character: in the outline, find <em>Characters</em>, press <kbd>n</kbd> and name the note after them. Now their name lights up in your story. Put the cursor on it and press <kbd>Ctrl-O</kbd> to see every scene they're in.</li>
            <li>Press <kbd>Ctrl-K</kbd>, type <em>names</em>, and choose <em>Check names for near-miss spellings</em>.</li>
            <li>Press <kbd>Ctrl-K</kbd>, type <em>echo</em>, and turn on echo words. Words you've repeated too close together light up. Change a few.</li>
            <li>Swap seats with your partner. Read one of their scenes and leave notes inside it, with your name: <code>%% Sam: I love this line %%</code>. Notes never reach their story.</li>
            <li>Back at your seat, <kbd>Ctrl-T</kbd> finds your partner's notes.</li>
            <li>In the outline, press <kbd>H</kbd> on a scene to see how it changed. Then on the corkboard (<kbd>b</kbd>), press <kbd>s</kbd> to mark finished scenes <em>revised</em>.</li>
          </ol>

          <h3>Revision checklist</h3>
          <ul class="check">
            <li>My story has a beginning, a middle and an end.</li>
            <li>My main character wants something, and something gets in the way.</li>
            <li>Something changes by the end.</li>
            <li>No TKs are left.</li>
            <li>My notes are dealt with.</li>
            <li>Names are spelled the same everywhere.</li>
            <li>I changed at least three echo words.</li>
            <li>I read my partner's notes and used at least one.</li>
          </ul>

          <h3>Partner notes</h3>
          <div class="boxes two">
            <div class="box">
              <div class="card-field"><b>Reader</b><i></i></div>
              <div class="card-field"><b>Scene</b><i></i></div>
              <p class="q">I loved…</p>
            </div>
            <div class="box">
              <p class="q">I wondered…</p>
              <p class="q" style="margin-top: 3.5rem;">One suggestion…</p>
            </div>
          </div>

          <h3>Exit ticket</h3>
          <Lines n={1} prompt="1. What's the difference between revising and editing?" />
          <Lines n={1} prompt="2. How can a partner leave notes that never reach your story?" />
          <Lines n={1} prompt="3. Where can you see how a scene has changed?" />
        </section>

        <!-- DAY 5 -->
        <section id="day-5" class="day" data-printable>
          <div class="day-head">
            <span class="day-num" aria-hidden="true">5</span>
            <span class="day-kicker">Day 5</span>
            <h2>Publish</h2>
          </div>
          <div class="day-tools no-print"><button class="btn small" data-print="day-5">⎙ Print this day</button></div>
          <p class="intro">Today your story becomes a real manuscript, formatted the way editors expect. Then you read like a reader, and look back on your week.</p>

          <h3>Follow along</h3>
          <ol class="steps">
            <li>Last check: <kbd>Ctrl-T</kbd> should show nothing left to do. Look at your word count in the status bar.</li>
            <li>Press <kbd>Esc</kbd>, choose <em>Settings…</em>, then <em>Author details…</em>. Type the name you want on your story. <kbd>↑</kbd> <kbd>↓</kbd> move between the boxes, and <kbd>Esc</kbd> saves.</li>
            <li>Keep it private: leave your home address and phone number blank. Your name and class are plenty.</li>
            <li>Press <kbd>Esc</kbd> and choose <em>Export…</em>. Make sure <em>Word manuscript</em> is ticked (<kbd>Space</kbd> ticks and unticks), and <em>PDF</em> too if your teacher says so.</li>
            <li>Press <kbd>x</kbd> to export. If Grimoire lists TKs you missed, fill them in, or export again to go ahead.</li>
            <li>Open your book's folder, then <code>exports</code>. There's your manuscript.</li>
            <li>Open it and find: the title page with your word count, your name and title at the top of each page, a <code>#</code> between scenes, and END.</li>
          </ol>

          <h3>Read like a reader</h3>
          <p>Swap manuscripts with a partner and read theirs start to finish.</p>
          <Lines n={2} prompt="One thing I loved:" />
          <Lines n={2} prompt="One question I still have:" />

          <h3>Before you celebrate</h3>
          <ul class="check">
            <li>My author details are filled in (name only, nothing private).</li>
            <li>I exported a Word manuscript.</li>
            <li>I opened it and checked the title page.</li>
            <li>A partner read it.</li>
            <li>I picked a theme to celebrate (<kbd>F9</kbd>).</li>
          </ul>

          <h3>Look back on your week</h3>
          <Lines n={2} prompt="What are you proudest of in your story?" />
          <Lines n={2} prompt="What was hardest?" />
          <Lines n={2} prompt="Which tool helped you most: sprints, notes and TKs, the corkboard, or history? Why?" />
          <Lines n={2} prompt="What would you write next?" />
        </section>

        <!-- CERTIFICATE -->
        <section id="certificate" class="block page cert" data-printable>
          <div class="day-tools no-print"><button class="btn small" data-print="certificate">⎙ Print the certificate</button></div>
          <div class="cert-card">
            <p class="eyebrow">A Week with Grimoire</p>
            <h2 class="cert-title"><span class="rb">Author</span></h2>
            <p class="cert-line">This is to say that</p>
            <div class="cert-blank"></div>
            <p class="cert-line">wrote a story called</p>
            <div class="cert-blank"></div>
            <p class="cert-line">of <span class="cert-short"></span> words, from the first idea to a finished manuscript.</p>
            <div class="cert-sign">
              <span>Teacher <i></i></span>
              <span>Date <i></i></span>
            </div>
          </div>
        </section>
      </div>
    </div>

    <script is:inline>
      (() => {
        const links = new Map([...document.querySelectorAll('.toc a')].map((a) => [a.getAttribute('href').slice(1), a]));
        const io = new IntersectionObserver((es) => {
          es.forEach((e) => {
            if (!e.isIntersecting) return;
            links.forEach((a) => a.classList.remove('on'));
            links.get(e.target.id)?.classList.add('on');
          });
        }, { rootMargin: '-30% 0px -60% 0px' });
        links.forEach((_, id) => { const el = document.getElementById(id); if (el) io.observe(el); });
      })();
    </script>
  </main>
</Learn>
